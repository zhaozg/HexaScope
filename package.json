{
  "name": "hexascope",
  "version": "0.1.0",
  "description": "基于 GitHub 原生生态的开发者六维能力雷达图生成器",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "evaluate": "bun scripts/cli.ts evaluate",
    "score": "bun scripts/cli.ts score",
    "radar": "bun scripts/generateRadar.ts",
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint scripts tests",
    "format": "prettier --write \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "frontend:dev": "cd frontend && nue dev",
    "frontend:build": "bun scripts/frontend-build.ts",
    "frontend:preview": "cd frontend && nue preview"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "nuekit": "^2.0.0-beta.2"
  }
}
